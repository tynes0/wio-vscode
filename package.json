{
  "name": "wio-vscode",
  "displayName": "Wio Language Support",
  "description": "First-class editing, diagnostics, project commands, and navigation for Wio 0.11.",
  "repository": "https://github.com/tynes0/wio-vscode",
  "version": "0.11.0",
  "publisher": "local",
  "license": "MIT",
  "main": "./src/extension.js",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": ["workspace"],
  "categories": ["Programming Languages", "Linters", "Snippets"],
  "activationEvents": ["onLanguage:wio"],
  "scripts": {
    "check": "node ./scripts/check.js",
    "test": "node --test ./test/*.test.js",
    "package": "npm run check && npm test && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  },
  "contributes": {
    "languages": [{
      "id": "wio",
      "aliases": ["Wio", "wio"],
      "extensions": [".wio"],
      "configuration": "./language-configuration.json",
      "icon": {
        "light": "./assets/wio-file-light.svg",
        "dark": "./assets/wio-file-dark.svg"
      }
    }],
    "grammars": [{
      "language": "wio",
      "scopeName": "source.wio",
      "path": "./syntaxes/wio.tmLanguage.json"
    }],
    "snippets": [{
      "language": "wio",
      "path": "./snippets/wio.json"
    }],
    "commands": [
      { "command": "wio.checkCurrentFile", "title": "Check Current File", "category": "Wio", "icon": "$(check)" },
      { "command": "wio.runCurrentFile", "title": "Run Current File", "category": "Wio", "icon": "$(play)" },
      { "command": "wio.emitCppCurrentFile", "title": "Emit Generated C++", "category": "Wio", "icon": "$(file-code)" },
      { "command": "wio.showBackendInfoCurrentFile", "title": "Show Backend Information", "category": "Wio", "icon": "$(tools)" },
      { "command": "wio.buildProject", "title": "Build Project", "category": "Wio", "icon": "$(gear)" },
      { "command": "wio.runProject", "title": "Run Project", "category": "Wio", "icon": "$(debug-start)" },
      { "command": "wio.testProject", "title": "Test Project", "category": "Wio", "icon": "$(beaker)" },
      { "command": "wio.doctor", "title": "Run Environment Doctor", "category": "Wio", "icon": "$(heart-pulse)" },
      { "command": "wio.restartIndex", "title": "Restart Workspace Index", "category": "Wio", "icon": "$(refresh)" },
      { "command": "wio.showOutput", "title": "Show Output", "category": "Wio", "icon": "$(output)" },
      { "command": "wio.clearDiagnostics", "title": "Clear Diagnostics", "category": "Wio", "icon": "$(clear-all)" }
    ],
    "configuration": {
      "title": "Wio",
      "properties": {
        "wio.executable": {
          "type": "string",
          "default": "wio",
          "scope": "machine-overridable",
          "description": "Wio executable path or command name."
        },
        "wio.defaultArgs": {
          "type": "array",
          "default": [],
          "items": { "type": "string" },
          "description": "Extra compiler or project arguments passed to every Wio invocation."
        },
        "wio.enableDiagnosticsOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Check a Wio file after it is saved."
        },
        "wio.enableDiagnosticsOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Check a Wio file when it is opened."
        },
        "wio.diagnosticsDebounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "maximum": 5000,
          "description": "Delay before automatic diagnostics are launched."
        },
        "wio.showOutputOnSuccess": {
          "type": "boolean",
          "default": false,
          "description": "Reveal the Wio output channel after successful commands."
        },
        "wio.runArgs": {
          "type": "array",
          "default": [],
          "items": { "type": "string" },
          "description": "Program arguments passed after `--` for file and project runs."
        },
        "wio.index.maxFiles": {
          "type": "number",
          "default": 4000,
          "minimum": 1,
          "maximum": 50000,
          "description": "Maximum Wio files included in workspace navigation."
        },
        "wio.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Controls extension diagnostic logging."
        }
      }
    },
    "keybindings": [
      { "command": "wio.checkCurrentFile", "key": "ctrl+alt+w", "mac": "cmd+alt+w", "when": "editorLangId == wio && editorTextFocus" },
      { "command": "wio.runCurrentFile", "key": "ctrl+alt+r", "mac": "cmd+alt+r", "when": "editorLangId == wio && editorTextFocus" },
      { "command": "wio.buildProject", "key": "ctrl+alt+b", "mac": "cmd+alt+b", "when": "editorLangId == wio" }
    ],
    "menus": {
      "editor/title": [
        { "command": "wio.checkCurrentFile", "when": "resourceExtname == .wio", "group": "navigation@100" },
        { "command": "wio.runCurrentFile", "when": "resourceExtname == .wio", "group": "navigation@101" }
      ],
      "explorer/context": [
        { "command": "wio.checkCurrentFile", "when": "resourceExtname == .wio", "group": "wio@10" },
        { "command": "wio.runCurrentFile", "when": "resourceExtname == .wio", "group": "wio@11" }
      ]
    }
  },
  "keywords": ["wio", "language", "compiler", "async", "native", "interop"]
}

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Wio",
  "scopeName": "source.wio",
  "patterns": [
    { "include": "#comments" },
    { "include": "#interpolatedStrings" },
    { "include": "#strings" },
    { "include": "#using" },
    { "include": "#modernAttributes" },
    { "include": "#legacyAttributes" },
    { "include": "#declarations" },
    { "include": "#lifecycle" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#scopedNames" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.wio", "begin": "//", "end": "$", "beginCaptures": { "0": { "name": "punctuation.definition.comment.wio" } } },
        { "name": "comment.block.wio", "begin": "/\\*", "end": "\\*/", "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.wio" } }, "endCaptures": { "0": { "name": "punctuation.definition.comment.end.wio" } }, "patterns": [{ "include": "#comments" }] }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.double.unicode.wio", "begin": "u\"", "end": "\"", "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.wio" } }, "endCaptures": { "0": { "name": "punctuation.definition.string.end.wio" } }, "patterns": [{ "name": "constant.character.escape.wio", "match": "\\\\(?:[\\\\\"'0abfnrtv]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})" }] },
        { "name": "string.quoted.double.wio", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.wio", "match": "\\\\(?:[\\\\\"'0abfnrtv]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})" }] },
        { "name": "string.quoted.single.wio", "begin": "'", "end": "'", "patterns": [{ "name": "constant.character.escape.wio", "match": "\\\\." }] }
      ]
    },
    "interpolatedStrings": {
      "patterns": [{
        "name": "string.quoted.double.unicode.interpolated.wio",
        "begin": "u\\$\"",
        "end": "\"",
        "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.wio" } },
        "endCaptures": { "0": { "name": "punctuation.definition.string.end.wio" } },
        "patterns": [
          { "name": "constant.character.escape.wio", "match": "\\\\." },
          { "include": "#interpolation" }
        ]
      }, {
        "name": "string.quoted.double.interpolated.wio",
        "begin": "\\$\"",
        "end": "\"",
        "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.wio" } },
        "endCaptures": { "0": { "name": "punctuation.definition.string.end.wio" } },
        "patterns": [
          { "name": "constant.character.escape.wio", "match": "\\\\." },
          { "include": "#interpolation" }
        ]
      }]
    },
    "interpolation": {
      "patterns": [{
        "name": "meta.interpolation.wio",
        "begin": "\\$\\{",
        "end": "\\}",
        "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.wio" } },
        "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.wio" } },
        "patterns": [
          { "include": "#comments" }, { "include": "#interpolatedStrings" }, { "include": "#strings" },
          { "name": "meta.brace.curly.wio", "begin": "\\{", "end": "\\}", "patterns": [{ "include": "$self" }] },
          { "include": "$self" }
        ]
      }]
    },
    "using": {
      "patterns": [{
        "name": "meta.attribute.using.wio", "begin": "\\b(using)(?=\\s)", "end": ";",
        "beginCaptures": { "1": { "name": "keyword.control.import.wio" } },
        "endCaptures": { "0": { "name": "punctuation.terminator.statement.wio" } },
        "patterns": [{ "include": "#strings" }, { "include": "#numbers" }, { "include": "#scopedNames" }, { "include": "#calls" }]
      }, {
        "name": "meta.import.wio", "begin": "\\b(use)(?=\\s)", "end": ";",
        "beginCaptures": { "1": { "name": "keyword.control.import.wio" } },
        "endCaptures": { "0": { "name": "punctuation.terminator.statement.wio" } },
        "patterns": [{ "name": "keyword.control.import.wio", "match": "\\bas\\b" }, { "include": "#scopedNames" }]
      }]
    },
    "modernAttributes": {
      "patterns": [{
        "name": "meta.attribute.postfix.wio", "begin": "\\b(with)(?=\\s)", "end": "(?=\\{|;|$)",
        "beginCaptures": { "1": { "name": "keyword.other.attribute.wio" } },
        "patterns": [
          { "name": "entity.name.function.attribute.wio", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()" },
          { "name": "entity.name.namespace.wio", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=::)" },
          { "name": "entity.name.tag.wio", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" },
          { "include": "#strings" }, { "include": "#numbers" }
        ]
      }]
    },
    "legacyAttributes": {
      "patterns": [{ "match": "(@)([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "punctuation.definition.annotation.wio" }, "2": { "name": "entity.name.tag.wio" } } }]
    },
    "declarations": {
      "patterns": [
        { "match": "\\b(async\\s+)?(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "storage.modifier.async.wio" }, "2": { "name": "storage.type.function.wio" }, "3": { "name": "entity.name.function.wio" } } },
        { "match": "\\b(object|component|interface|enum|flagset|type|opaque)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "storage.type.declaration.wio" }, "2": { "name": "entity.name.type.wio" } } },
        { "match": "\\b(attribute)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "storage.type.attribute.wio" }, "2": { "name": "entity.name.tag.wio" } } },
        { "match": "\\b(application|system)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "storage.type.declaration.wio" }, "2": { "name": "entity.name.type.wio" } } },
        { "match": "\\b(extension)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "storage.type.declaration.wio" }, "2": { "name": "entity.name.type.wio" } } },
        { "match": "\\b(realm)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "keyword.control.namespace.wio" }, "2": { "name": "entity.name.namespace.wio" } } }
      ]
    },
    "lifecycle": {
      "patterns": [{ "match": "\\b(on)\\s+(start|update|close)\\b", "captures": { "1": { "name": "keyword.control.lifecycle.wio" }, "2": { "name": "entity.name.function.lifecycle.wio" } } }]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.wio", "match": "\\b0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*(?:[iu](?:8|16|32|64|size))?\\b" },
        { "name": "constant.numeric.binary.wio", "match": "\\b0[bB][01](?:_?[01])*(?:[iu](?:8|16|32|64|size))?\\b" },
        { "name": "constant.numeric.float.wio", "match": "\\b(?:[0-9](?:_?[0-9])*)?\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9]+)?(?:f(?:32|64)?)?\\b" },
        { "name": "constant.numeric.integer.wio", "match": "\\b[0-9](?:_?[0-9])*(?:[iu](?:8|16|32|64|size))?\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.wio", "match": "\\b(?:true|false)\\b" },
        { "name": "constant.language.null.wio", "match": "\\b(?:null|none)\\b" },
        { "name": "constant.language.pattern.wio", "match": "\\b(?:Some|None|Ok|Err|assumed)\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.flow.wio", "match": "\\b(?:if|else|while|loop|for|foreach|in|match|when|return|break|continue|yield)\\b" },
        { "name": "keyword.control.async.wio", "match": "\\b(?:async|await|coroutine|spawn|thread|every|after|during|wait)\\b" },
        { "name": "keyword.operator.word.wio", "match": "\\b(?:and|or|not|is|fit)\\b" },
        { "name": "storage.modifier.wio", "match": "\\b(?:let|mut|const|ref|view|public|private|protected|native|retain|repeatable|scoped|conflicts|final|readonly)\\b" },
        { "name": "variable.language.wio", "match": "\\b(?:self|super)\\b" },
        { "name": "keyword.other.where.wio", "match": "\\bwhere\\b" }
      ]
    },
    "types": {
      "patterns": [{ "name": "support.type.primitive.wio", "match": "\\b(?:i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|isize|usize|byte|bool|char|uchar|string|text|void|object|opaque)\\b" }]
    },
    "calls": {
      "patterns": [{ "name": "entity.name.function.call.wio", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*(?:<[^;{}()]*>)?\\s*\\()" }]
    },
    "scopedNames": {
      "patterns": [
        { "name": "entity.name.namespace.wio", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=::)" },
        { "name": "punctuation.accessor.scope.wio", "match": "::" }
      ]
    }
  }
}

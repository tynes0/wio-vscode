{
  "Entry Function": {
    "prefix": "entry",
    "body": ["fn Entry(args: string[]) -> i32 {", "    ${1:std::console::PrintLine(\"Hello from Wio.\");}", "    return ${2:0};", "}"],
    "description": "Create a synchronous Wio entry point."
  },
  "Async Entry Function": {
    "prefix": "async-entry",
    "body": ["async fn Entry(args: string[]) -> i32 {", "    ${1:await std::async::Yield();}", "    return ${2:0};", "}"],
    "description": "Create an asynchronous Wio entry point."
  },
  "Application": {
    "prefix": "application",
    "body": ["application ${1:DesktopApp} {", "    fn Start() {", "        ${2}", "    }", "", "    fn Update(delta: f64) {", "        ${3}", "    }", "", "    fn Close() {", "        ${4}", "    }", "}"],
    "description": "Create a Wio 0.17 application with ordinary lifecycle functions."
  },
  "Attributed Application Schedule": {
    "prefix": "application-schedule",
    "body": ["system ${1:Simulation} {", "    ticks: u64;", "", "    fn Update(delta: f64) {", "        ${2:self.ticks += 1u64;}", "    }", "}", "", "application ${3:DesktopApp} {", "    simulation: ${1:Simulation};", "", "    [Fixed(${4:60})]", "    fn ${5:Physics}(step: f64) {", "        ${6}", "    }", "", "    [After(${5:Physics})]", "    [Main]", "    fn ${7:Render}(delta: f64) {", "        ${8}", "    }", "", "    [Update]", "    fn ${9:Frame}(delta: f64) {", "        ${10}", "    }", "}"],
    "description": "Create an attribute-driven deterministic application schedule."
  },
  "Composed Application Policy": {
    "prefix": "application-policy",
    "body": ["attribute ${1:FrameStep}(rate: f64) for handler", "    compose [Update, Fixed(rate), Main];", "", "[${1:FrameStep}(${2:60.0})]", "fn ${3:Advance}(step: f64) {", "    ${4}", "}"],
    "description": "Compose reusable Wio 0.17 lifecycle and scheduling policy for an application handler."
  },
  "Application System": {
    "prefix": "system",
    "body": ["system ${1:WorkspaceSystem} {", "    ${2:ready}: bool;", "", "    fn Start() {", "        self.${2:ready} = false;", "        ${3}", "    }", "", "    fn Update(delta: f64) {", "        ${4}", "    }", "", "    fn Close() {", "        ${5}", "    }", "}"],
    "description": "Create a stack-resident Wio 0.17 system with ordinary functions."
  },
  "Application Lifecycle Attribute": {
    "prefix": "application-lifecycle",
    "body": ["[${1|Start,Update,Close|}]", "fn ${2:Handler}(${3}) {", "    ${4}", "}"],
    "description": "Bind a descriptive function name to an application/system lifecycle role."
  },
  "Function": {
    "prefix": "fn",
    "body": ["fn ${1:Name}(${2})${3: -> void} {", "    ${4}", "}"],
    "description": "Create a Wio function."
  },
  "Async Function": {
    "prefix": "async-fn",
    "body": ["async fn ${1:Load}(${2}) -> ${3:std::Result<string>} {", "    ${4}", "}"],
    "description": "Create a Wio async function."
  },
  "Object": {
    "prefix": "object",
    "body": ["object ${1:Entity} {", "    public ${2:id}: ${3:i32};", "", "    OnConstruct(${2:id}: ${3:i32}) {", "        self.${2:id} = ${2:id};", "    }", "", "    public fn ${4:Describe}() -> string {", "        ${5:return \"Entity\";}", "    }", "}"],
    "description": "Create a managed Wio object."
  },
  "Component": {
    "prefix": "component",
    "body": ["component ${1:Vector2} {", "    ${2:x}: ${3:f32};", "    ${4:y}: ${3:f32};", "}"],
    "description": "Create a stack-resident Wio component."
  },
  "Component Extension": {
    "prefix": "extension",
    "body": ["extension ${1:Vector2Extensions} for ${2:Vector2} {", "    fn ${3:Length}(self: view ${2:Vector2}) -> ${4:f32} {", "        ${5}", "    }", "}"],
    "description": "Create member-style behavior for a component."
  },
  "Typed Attribute": {
    "prefix": "attribute",
    "body": ["attribute ${1:Route}(${2:path}: ${3:string} = \"${4:/}\") for ${5:fn} retain ${6:runtime};"],
    "description": "Declare a typed user attribute."
  },
  "Unicode Text": {
    "prefix": "text",
    "body": ["let ${1:message}: text = u\"${2:Merhaba 🌍}\";"],
    "description": "Create a validated Unicode-semantic text value."
  },
  "Interpolated Unicode Text": {
    "prefix": "text-interpolation",
    "body": ["let ${1:message}: text = u$\"${2:Value}: \\${${3:value}}\";"],
    "description": "Create interpolated Unicode text with a nested Wio expression."
  },
  "Textual Const Generic": {
    "prefix": "const-generic-text",
    "body": ["component ${1:Named}<const ${2:Name}: ${3:string} = \"${4:unnamed}\"> {", "    ${5:value}: ${6:i32};", "}"],
    "description": "Create a component with a string or text const generic parameter."
  },
  "Fixed Array Inferred Extent": {
    "prefix": "fixed-array-auto",
    "body": ["let ${1:values}: [${2:i32}; _] = [${3:1, 2, 3}];"],
    "description": "Infer a fixed-array extent from its initializer."
  },
  "Guarded Match Arm": {
    "prefix": "match-guard",
    "body": ["match (${1:value}) {", "    ${2:caseValue} if ${3:condition}: { ${4} }", "    assumed: { ${5} }", "}"],
    "description": "Create a match with a boolean arm guard."
  },
  "Native Header": {
    "prefix": "cpp-header",
    "body": ["using cpp::header(\"${1:native_api.h}\");"],
    "description": "Include a C++ header through modern attribute syntax."
  },
  "Native Function": {
    "prefix": "native-fn",
    "body": ["[Native, CppName(${4:native_api::NativeCall})]", "fn ${1:NativeCall}(${2}) -> ${3:i32};"],
    "description": "Declare a native-backed function."
  },
  "Result Match": {
    "prefix": "match-result",
    "body": ["match (${1:result}) {", "    Ok(${2:value}): { ${3} }", "    Err(${4:message}): { ${5} }", "}"],
    "description": "Match a std::Result value."
  },
  "Option Match": {
    "prefix": "match-option",
    "body": ["match (${1:option}) {", "    Some(${2:value}): { ${3} }", "    None: { ${4} }", "}"],
    "description": "Match a std::Option value."
  },
  "Async Task": {
    "prefix": "async-task",
    "body": ["let ${1:task}: coroutine<${2:string}> = std::async::RunBlocking<${2:string}>(() -> ${2:string} {", "    ${3}", "});", "let ${4:value}: ${2:string} = await ${1:task};"],
    "description": "Start blocking work and await its coroutine."
  },
  "Structured Async Scope": {
    "prefix": "async-scope",
    "body": ["async scope {", "    let ${1:task} = spawn ${2:operation}();", "    let ${3:value} = await ${1:task};", "    ${4}", "}"],
    "description": "Run child work in an owning lexical async scope."
  },
  "Cancellation-aware File Read": {
    "prefix": "async-cancellable-read",
    "body": ["async fn ${1:Read}(path: string, token: std::async::CancellationToken) -> std::Result<string> {", "    return await std::fs::ReadTextAsync(path, token);", "}"],
    "description": "Read a file asynchronously with explicit cooperative cancellation."
  },
  "For In": {
    "prefix": "forin",
    "body": ["for ${1:item} in ${2:items} {", "    ${3}", "}"],
    "description": "Iterate over a collection."
  }
}

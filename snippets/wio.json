{
  "Entry Function": {
    "prefix": "entry",
    "body": ["fn Entry(args: string[]) -> i32 {", "    ${1:std::console::PrintLine(\"Hello from Wio.\");}", "    return ${2:0};", "}"],
    "description": "Create a synchronous Wio entry point."
  },
  "Async Entry Function": {
    "prefix": "async-entry",
    "body": ["async fn Entry(args: string[]) -> i32 {", "    ${1:await std::async::Yield();}", "    return ${2:0};", "}"],
    "description": "Create an asynchronous Wio entry point."
  },
  "Application": {
    "prefix": "application",
    "body": ["application ${1:DesktopApp} {", "    on start {", "        ${2}", "    }", "", "    on update {", "        ${3}", "    }", "", "    on close {", "        ${4}", "    }", "}"],
    "description": "Create a Wio application lifecycle."
  },
  "Application System": {
    "prefix": "system",
    "body": ["system ${1:WorkspaceSystem} {", "    mut ${2:ready}: bool;", "", "    on start {", "        self.${2:ready} = false;", "        ${3}", "    }", "", "    on update {", "        ${4}", "    }", "", "    on close {", "        ${5}", "    }", "}"],
    "description": "Create a stack-resident application system."
  },
  "Function": {
    "prefix": "fn",
    "body": ["fn ${1:Name}(${2})${3: -> void} {", "    ${4}", "}"],
    "description": "Create a Wio function."
  },
  "Async Function": {
    "prefix": "async-fn",
    "body": ["async fn ${1:Load}(${2}) -> ${3:std::Result<string>} {", "    ${4}", "}"],
    "description": "Create a Wio async function."
  },
  "Object": {
    "prefix": "object",
    "body": ["object ${1:Entity} {", "    public ${2:id}: ${3:i32};", "", "    OnConstruct(${2:id}: ${3:i32}) {", "        self.${2:id} = ${2:id};", "    }", "", "    public fn ${4:Describe}() -> string {", "        ${5:return \"Entity\";}", "    }", "}"],
    "description": "Create a managed Wio object."
  },
  "Component": {
    "prefix": "component",
    "body": ["component ${1:Vector2} {", "    ${2:x}: ${3:f32};", "    ${4:y}: ${3:f32};", "}"],
    "description": "Create a stack-resident Wio component."
  },
  "Component Extension": {
    "prefix": "extension",
    "body": ["extension ${1:Vector2Extensions} for ${2:Vector2} {", "    fn ${3:Length}(self: view ${2:Vector2}) -> ${4:f32} {", "        ${5}", "    }", "}"],
    "description": "Create member-style behavior for a component."
  },
  "Typed Attribute": {
    "prefix": "attribute",
    "body": ["attribute ${1:label}(${2:value}: ${3:string}) for ${4:component} retain;"],
    "description": "Declare a typed user attribute."
  },
  "Native Header": {
    "prefix": "cpp-header",
    "body": ["using cpp::header(\"${1:native_api.h}\");"],
    "description": "Include a C++ header through modern attribute syntax."
  },
  "Native Function": {
    "prefix": "native-fn",
    "body": ["fn ${1:NativeCall}(${2}) -> ${3:i32}", "    with native, cpp::name(${4:native_api::NativeCall});"],
    "description": "Declare a native-backed function."
  },
  "Result Match": {
    "prefix": "match-result",
    "body": ["match (${1:result}) {", "    Ok(${2:value}): { ${3} }", "    Err(${4:message}): { ${5} }", "}"],
    "description": "Match a std::Result value."
  },
  "Option Match": {
    "prefix": "match-option",
    "body": ["match (${1:option}) {", "    Some(${2:value}): { ${3} }", "    None: { ${4} }", "}"],
    "description": "Match a std::Option value."
  },
  "Async Task": {
    "prefix": "async-task",
    "body": ["let ${1:task}: coroutine<${2:string}> = std::async::RunBlocking<${2:string}>(() -> ${2:string} {", "    ${3}", "});", "let ${4:value}: ${2:string} = await ${1:task};"],
    "description": "Start blocking work and await its coroutine."
  },
  "For In": {
    "prefix": "forin",
    "body": ["for ${1:item} in ${2:items} {", "    ${3}", "}"],
    "description": "Iterate over a collection."
  }
}
